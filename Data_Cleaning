## Machine Learnimg Model creation

import pandas as pd
report = pd.read_csv("Final_report.csv")

## Importing the necessary libraries and Metrics

from sklearn.preprocessing import StandardScaler,MinMaxScaler,RobustScaler
from sklearn.preprocessing import OrdinalEncoder,OneHotEncoder
from sklearn.model_selection import train_test_split
from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import PolynomialFeatures
import xgboost as xgb
from sklearn.ensemble import RandomForestRegressor
import joblib

# Model

from sklearn.linear_model import LinearRegression,Ridge,Lasso

from sklearn.metrics import mean_squared_error,mean_absolute_error,r2_score,root_mean_squared_error


Num_cont = report[['views', 'likes', 'comments', 'watch_time_minutes',
       'video_length_minutes', 'subscribers']]
cat = report[[ 'category', 'device', 'country']]

Features = report.drop(["ad_revenue_usd","date","video_id"], axis = 1)
Target = report['ad_revenue_usd']

## Linear Regression Model

Num = Pipeline(steps = [("Impute",SimpleImputer(strategy = "median")),("Scaling", StandardScaler())])
Cat = Pipeline(steps = [("Impute", SimpleImputer(strategy = "most_frequent")),("Encoding", OneHotEncoder(handle_unknown = "ignore"))])
Trans = ColumnTransformer(transformers = [("Numeric", Num,Num_cont.columns.to_list()),("Cat",Cat,cat.columns.to_list())])
LR_Pipeline = Pipeline(steps = [("Preprocess_steps", Trans),("LR",LinearRegression())])
LR_Pipeline
Features_Train_LR,Features_Test_LR,Target_Train_LR,Target_Test_LR = train_test_split(Features,Target,test_size = 0.2,random_state = 17)
LR_Pipeline.fit(Features_Train_LR,Target_Train_LR)

Feature_train_Predict_LR = LR_Pipeline.predict(Features_Train_LR)
Feature_test_Predict_LR = LR_Pipeline.predict(Features_Test_LR)

MAE_LR_Train = mean_absolute_error(Target_Train_LR,Feature_train_Predict_LR)
MAE_LR_Test = mean_absolute_error(Target_Test_LR,Feature_test_Predict_LR)

RMSE_LR_Train = root_mean_squared_error(Target_Train_LR,Feature_train_Predict_LR)
RMSE_LR_Test = root_mean_squared_error(Target_Test_LR,Feature_test_Predict_LR)

R2score_LR_Train = r2_score(Target_Train_LR,Feature_train_Predict_LR)
R2score_LR_Test = r2_score(Target_Test_LR,Feature_test_Predict_LR)

print("MAE_LR_Train",MAE_LR_Train, "in USD")
print("MAE_LR_Test",MAE_LR_Test, "in USD")
print("RMSE_LR_Train",RMSE_LR_Train, "in USD")
print("RMSE_LR_Test",RMSE_LR_Test, "in USD")
print("R2score_LR_Train",R2score_LR_Train, "in USD")
print("R2score_LR_Test",R2score_LR_Test, "in USD")

